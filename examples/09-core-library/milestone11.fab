func main() {
    print(str_length("Fubby 🐾"))
    print(str_substring("Fubby", 1, 4))
    print(str_repeat("ha", 3))
    print(math_sin(0))

    let items = [3, 1, 2]
    print(list_contains(items, 1))
    print(list_slice(items, 1, 3))
    print(list_concat(items, [4]))
    print(list_insert(items, 1, 9))
    print(list_remove(items, 0))

    let data = {"name": "Fubby", "active": true, "count": 3}
    print(map_keys(data))
    print(map_values(data))
    let encoded = json_encode(data)
    print(encoded)
    print(json_encode(json_decode(encoded)))

    print(regex_is_match("abc123", "^a.*3$"))
    print(encoding_hex_encode("ok"))
    print(encoding_hex_decode("6f6b"))
    print(encoding_base64_encode("Fubby"))
    print(encoding_base64_decode("RnViYnk="))
    print(time_format_utc(time_parse_utc("2000-02-29T23:59:59Z")))
    print(time_is_leap_year(2000))
    print(time_days_in_month(2024, 2))
    print(system_os())
    print(system_arch())
    print(len(system_args()))
    print(clock_unix_millis() > 0)
    print(random_int(1, 10) >= 1)
    print(env_has("PATH"))

    try {
        throw "expected failure"
    } catch (err) {
        print(str_contains(err, "expected failure"))
        print(error_contains(error_message(err), "expected failure"))
    }
}
